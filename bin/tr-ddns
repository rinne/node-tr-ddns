#! /usr/bin/env node
'use strict';

const fs = require('node:fs');

const ipaddr = require('ipaddr.js');

const NameDB = require('../lib/namedb');
const NameServer = require('../lib/nameserver');
const ApiServer = require('../lib/apiserver');
const ApiCore = require('../lib/api');
const ControlServer = require('../lib/controlserver');
const ConfigStore = require('../lib/store');
const log = require('../lib/log');

function commandLineOptsParse() {
	function validIpAddrCb(s) {
		if (! ipaddr.isValid(s)) {
			return undefined;
		}
		return ipaddr.parse(s).toNormalizedString();
	}
	// One address or several separated by commas.
	function validIpAddrListCb(s) {
		let list = s.split(',').map((x) => validIpAddrCb(x.trim()));
		if (list.some((x) => (x === undefined))) {
			return undefined;
		}
		return list.join(',');
	}
	const ou = require('optist/util');
	return ((new (require('optist')))
			.opts([].concat(
				[ { longName: 'debug',
					description: 'Enable debug messages',
					environment: 'TR_DDNS_OPT_DEBUG' },
				  { longName: 'log-level',
					description: 'Log level: none, error, warn, info or debug',
					hasArg: true,
					optArgCb: ou.allowListCbFactory(log.LEVELS),
					environment: 'TR_DDNS_OPT_LOG_LEVEL',
					defaultValue: 'info' } ],
				[ { longName: 'config-file',
					shortName: 'c',
					description: 'Configuration file',
					required: true,
					hasArg: true },
				  { longName: 'init-config-file',
					description: 'Initialize configuration file and exit' },
				  { longName: 'config-write-interval',
					description: 'Shortest time in seconds between writes of configuration file',
					hasArg: true,
					optArgCb: ou.integerWithLimitsCbFactory(0, 86400),
					environment: 'TR_DDNS_OPT_CONFIG_WRITE_INTERVAL',
					defaultValue: '10' } ],
				[ { longName: 'udp',
					description: 'Enable UDP server',
					environment: 'TR_DDNS_OPT_UDP' },
				  { longName: 'udp-listen-address',
					description: 'Listen address(es) for UDP server, comma separated',
					hasArg: true,
					optArgCb: validIpAddrListCb,
					environment: 'TR_DDNS_OPT_UDP_LISTEN_ADDRESS',
					defaultValue: '0.0.0.0' },
				  { longName: 'udp-listen-port',
					description: 'Listen port for UDP server',
					hasArg: true,
					optArgCb: ou.integerWithLimitsCbFactory(1, 65535),
					environment: 'TR_DDNS_OPT_UDP_LISTEN_PORT',
					defaultValue: '53' },
				  { longName: 'tcp',
					description: 'Enable TCP server',
					environment: 'TR_DDNS_OPT_TCP' },
				  { longName: 'tcp-listen-address',
					description: 'Listen address(es) for TCP server, comma separated',
					optArgCb: validIpAddrListCb,
					hasArg: true,
					defaultValue: '0.0.0.0',
					environment: 'TR_DDNS_OPT_TCP_LISTEN_ADDRESS' },
				  { longName: 'tcp-listen-port',
					hasArg: true,
					optArgCb: ou.integerWithLimitsCbFactory(1, 65535),
					environment: 'TR_DDNS_OPT_TCP_LISTEN_PORT',
					defaultValue: '53',
					description: 'Listen port for TCP server' },
				  { longName: 'dns-rate-limit',
					description: 'Queries per second answered to one source, 0 for no limit',
					hasArg: true,
					optArgCb: ou.integerWithLimitsCbFactory(0, 1000000),
					environment: 'TR_DDNS_OPT_DNS_RATE_LIMIT',
					defaultValue: NameServer.DEFAULT_RATE_LIMIT.toString() },
				  { longName: 'dns-refuse-out-of-zone',
					description: 'Answer REFUSED to queries outside of served domains instead of ignoring them',
					environment: 'TR_DDNS_OPT_DNS_REFUSE_OUT_OF_ZONE' },
				  { longName: 'http-api',
					description: 'Enable HTTP-API server',
					environment: 'TR_DDNS_OPT_HTTP_API' },
				  { longName: 'http-api-user',
					description: 'Required username for HTTP API server',
					hasArg: true,
					optArgCb: ((x) => ((x === '') ? undefined : x)),
					environment: 'TR_DDNS_OPT_HTTP_API_USER' },
				  { longName: 'http-api-password',
					description: 'Required password for HTTP API server',
					hasArg: true,
					optArgCb: ((x) => ((x === '') ? undefined : x)),
					environment: 'TR_DDNS_OPT_HTTP_API_PASSWORD',
					conflictsWith: [ 'http-api-password-file' ] },
				  { longName: 'http-api-password-file',
					description: 'File containing required password for HTTP API server',
					hasArg: true,
					optArgCb: ((x) => ((x === '') ? undefined : x)),
					environment: 'TR_DDNS_OPT_HTTP_API_PASSWORD_FILE' },
				  { longName: 'http-api-listen-address',
					description: 'Listen address for HTTP control server',
					hasArg: true,
					optArgCb: validIpAddrCb,
					environment: 'TR_DDNS_OPT_HTTP_API_LISTEN_ADDRESS',
					defaultValue: '0.0.0.0' },
				  { longName: 'http-api-listen-port',
					description: 'Listen port for HTTP-API server',
					hasArg: true,
					optArgCb: ou.integerWithLimitsCbFactory(1, 65535),
					environment: 'TR_DDNS_OPT_HTTP_API_LISTEN_PORT',
					defaultValue: '80' },
				  { longName: 'control-socket',
					description: 'Serve the API also on this Unix domain socket',
					hasArg: true,
					optArgCb: ((x) => ((x === '') ? undefined : x)),
					environment: 'TR_DDNS_OPT_CONTROL_SOCKET' },
				  { longName: 'control-socket-mode',
					description: 'Permissions of the control socket in octal',
					hasArg: true,
					optArgCb: ((x) => (/^[0-7]{3,4}$/.test(x) ? x : undefined)),
					environment: 'TR_DDNS_OPT_CONTROL_SOCKET_MODE',
					defaultValue: '600' } ] ))
			.help('tr-ddns')
			.helpMessageTail('Each option, except --config-file, --init-config-file and --help, can\n' +
							 'also be given in environment variable TR_DDNS_OPT_<NAME>, where <NAME>\n' +
							 'is the long option name in upper case with dashes as underscores, e.g.\n' +
							 'TR_DDNS_OPT_UDP_LISTEN_PORT=5300. An option without an argument is\n' +
							 'switched on with value true.')
			.parse(undefined, 0, 0));
}

function fatal(message) {
	console.error(message);
	process.exit(1);
}

// The user name and password for the API as the base64 string of a
// Basic authentication header, or null when authentication is not used.
function basicAuthCookie(opt) {
	let user = opt.value('http-api-user');
	let password = opt.value('http-api-password');
	let passwordFile = opt.value('http-api-password-file');
	if (passwordFile) {
		try {
			// The password is the first line of the file.
			password = fs.readFileSync(passwordFile, { encoding: 'utf8' }).split(/\r?\n/)[0];
		} catch (e) {
			fatal('Unable to read password file (' + (e.code ?? '?') + ')');
		}
		if (password === '') {
			fatal('Password file is empty');
		}
	}
	if (user && (! password)) {
		fatal('Option --http-api-user requires also --http-api-password or --http-api-password-file');
	}
	if (password && (! user)) {
		fatal('Options --http-api-password and --http-api-password-file require also --http-api-user');
	}
	return user ? Buffer.from(user + ':' + password).toString('base64') : null;
}

(async function() {
	const opt = commandLineOptsParse();
	// --debug is the same as --log-level=debug.
	const debug = (opt.value('debug') || (opt.value('log-level') === 'debug')) ? true : false;
	log.setLevel(debug ? 'debug' : opt.value('log-level'));
	const basicAuth = basicAuthCookie(opt);

	const db = new NameDB({ debug: debug });
	const store = new ConfigStore({ file: opt.value('config-file'),
									nameDB: db,
									writeIntervalMs: opt.value('config-write-interval') * 1000 });

	if (opt.value('init-config-file')) {
		try {
			await store.init();
		} catch (e) {
			fatal('Unable to initialize configuration file (' + (e.code ?? '?') + ')');
		}
		process.exit(0);
	}

	try {
		for (let warning of (await store.load())) {
			log.warn(warning);
		}
	} catch (e) {
		switch (e.code) {
		case 'ENOENT':
			fatal('Configuration file not found (ENOENT). Use --init-config-file to create it.');
			break;
		case 'EMALFORMED':
			fatal('Malformatted configuration');
			break;
		default:
			fatal('Unable to access configuration file (' + (e.code ?? '?') + ')');
		}
	}
	try {
		// The file is rewritten in the current format with the entries
		// that could not be used left out.
		await store.write({ untimed: true });
	} catch (e) {
		fatal('Unable to update configuration file (' + (e.code ?? '?') + ')');
	}

	store.on('write', function() { log('Config written'); });
	store.on('error', function(e) { fatal('Unable to save current configuration (' + (e?.code ?? '?') + ')'); });
	store.watch();

	if (debug) {
		for (let event of [ 'add', 'update', 'remove', 'flush', 'removedomain', 'adddomain', 'updatedomain' ]) {
			db.on(event, function(name) { log.debug('EVENT:', event + '(' + (name ? name : '') + ')'); });
		}
	}

	const server = ((opt.value('udp') || opt.value('tcp')) ?
					new NameServer({
						debug: debug,
						tcp: opt.value('tcp'),
						tcpListenPort: opt.value('tcp-listen-port'),
						tcpListenAddress: opt.value('tcp-listen-address'),
						udp: opt.value('udp'),
						udpListenPort: opt.value('udp-listen-port'),
						udpListenAddress: opt.value('udp-listen-address'),
						rateLimit: opt.value('dns-rate-limit'),
						refuseOutOfZone: opt.value('dns-refuse-out-of-zone'),
						nameDB: db
					}) :
					undefined);

	// A listener that cannot be started is fatal.
	if (server) {
		server.on('error', function(e) { fatal('Unable to start DNS server (' + (e?.code ?? '?') + ')'); });
	}

	// The API is the same whichever way it is reached.
	const apiCore = new ApiCore({ nameDB: db, nameServer: server, debug: debug });

	const api = (opt.value('http-api') ?
				 new ApiServer({ api: apiCore,
								 port: opt.value('http-api-listen-port'),
								 address: opt.value('http-api-listen-address'),
								 debug: debug,
								 basicAuth: basicAuth }) :
				 undefined);

	if (api) {
		api.on('error', function(e) { fatal('Unable to start HTTP server (' + (e?.code ?? '?') + ')'); });
		if ((basicAuth === null) && (ipaddr.parse(opt.value('http-api-listen-address')).range() !== 'loopback')) {
			log.warn('Warning: HTTP API listens on ' + opt.value('http-api-listen-address') +
					 ' without authentication. Anyone who can reach it can change and remove all records.');
		}
	}

	const control = (opt.value('control-socket') ?
					 new ControlServer({ api: apiCore,
										 path: opt.value('control-socket'),
										 mode: opt.value('control-socket-mode'),
										 debug: debug }) :
					 undefined);

	if (control) {
		control.on('error', function(e) { fatal('Unable to start control socket (' + (e?.code ?? '?') + ')'); });
	}

	// On a termination signal the pending changes are written to the
	// configuration file before the program exits.
	let stopping = false;
	const stop = function(signal) {
		if (stopping) {
			return;
		}
		stopping = true;
		log.debug('Stopping on', signal);
		// Whatever happens, the program does not hang around.
		setTimeout(function() { process.exit(1); }, 5000).unref();
		(async function() {
			let code = 0;
			try {
				await store.flush();
			} catch (e) {
				console.error('Unable to save current configuration (' + (e?.code ?? '?') + ')');
				code = 1;
			}
			store.close();
			await Promise.allSettled([ api, control, server ].map((x) => (x ? x.close() : undefined)));
			db.close();
			process.exit(code);
		})();
	};
	process.on('SIGTERM', function() { stop('SIGTERM'); });
	process.on('SIGINT', function() { stop('SIGINT'); });

})();
