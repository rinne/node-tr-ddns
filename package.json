{
	"name": "tr-ddns",
	"version": "1.1.1",
	"description": "Simple DDNS Server",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"bin": {
		"tr-ddns": "bin/tr-ddns"
	},
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./index": "./lib/index.js",
		"./index.js": "./lib/index.js",
		"./namedb": "./lib/namedb.js",
		"./namedb.js": "./lib/namedb.js",
		"./nameserver": "./lib/nameserver.js",
		"./nameserver.js": "./lib/nameserver.js",
		"./apiserver": "./lib/apiserver.js",
		"./apiserver.js": "./lib/apiserver.js",
		"./log": "./lib/log.js",
		"./log.js": "./lib/log.js",
		"./nullish": "./lib/nullish.js",
		"./nullish.js": "./lib/nullish.js",
		"./ts": "./lib/ts.js",
		"./ts.js": "./lib/ts.js"
	},
	"files": [
		"bin/",
		"lib/",
		"tr-ddns",
		"README.md",
		"LICENSE",
		"MIT-RINNE"
	],
	"scripts": {
		"test": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=bin/** --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"test/*.test.js\""
	},
	"engines": {
		"node": ">= 24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rinne/node-tr-ddns.git"
	},
	"keywords": [
		"dns",
		"dyndns",
		"ddns"
	],
	"bugs": {
		"url": "https://github.com/rinne/node-tr-ddns/issues"
	},
	"homepage": "https://github.com/rinne/node-tr-ddns#readme",
	"author": {
		"name": "Timo J. Rinne",
		"email": "tri@iki.fi",
		"url": "https://github.com/rinne/"
	},
	"license": "MIT",
	"dependencies": {
		"dns2": "^3.1.1",
		"ipaddr.js": "^2.2.0",
		"optist": "^3.0.0",
		"tr-apisrv": "^3.0.0"
	}
}
